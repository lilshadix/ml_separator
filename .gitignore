# Gen2 OOF predictions >100 MB - stored outside Git
runs/ablation_all_20260810T181058Z/run_0_model_42_split_104729/oof_predictions.csv
runs/ablation_all_20260810T181058Z/run_1_model_7_split_104729/oof_predictions.csv
runs/ablation_all_20260810T181058Z/run_2_model_137_split_104729/oof_predictions.csv
runs/ablation_all_20260810T181058Z/run_3_model_2027_split_104729/oof_predictions.csv
runs/ablation_all_20260810T181058Z/run_4_model_9001_split_104729/oof_predictions.csv

# gen7 cohort cache: deterministic and rebuilt in ~13 s by load_cohort(); checking it in
# would add 3.4 MB of derived parquet that must not be allowed to drift from the builder
# --- run artefacts ----------------------------------------------------------
# OOF prediction dumps are ~940 MB across gen7-gen11 and regenerate from the
# committed code.  Each run's manifest carries their SHA-256, so a rebuild stays
# checkable against what the reports cite.
runs/**/*.parquet
runs/**/*.log
runs/**/*.png

# Oversized CSV copies of source data / per-ligand dumps (37 MB)
runs/sae_dataset_audit/master_clean.csv
runs/gen9_shape/shape/per_ligand_shape.csv

# ...except the frozen cohort, which must stay in version control.  Every number
# from gen6 onward is defined against it (fingerprint bed178ec1a7a82b0; 5,248
# rows / 152 extractants / 131 ECFP clusters / 79 chemotypes).  A build recipe is
# not a sufficient substitute: cohort membership is weakly target-dependent, so a
# rebuild can differ by a few row ids.  It is 3.3 MB.
# This negation only works because the directory itself is no longer excluded.
!runs/gen7_architecture/cache/*.parquet

# --- Derived dataset builds -------------------------------------------------
# 86 MB all-metals build; rebuilt by the dataset-builder repo, not authored here
dataset_all_metals/

# 4.8 MB pretrained ligand embeddings; rebuilt by scripts/build_gen7_ligand_embeddings.py
# (its manifest IS committed so the build is reproducible and auditable)
dataset with 3D structures/ligand_pretrained_embeddings.parquet

# --- figures ----------------------------------------------------------------
# The rendered figure set was deleted 2026-09-04 and will be rebuilt.  What
# survives is the knowledge needed to rebuild it, under docs/figures/: the
# generator scripts, the pre-declared selection rules, the style guide,
# METRIC_AUDIT.md's claim guardrails, and the small derived JSON/CSV that the
# captions cite (so every plotted number stays checkable without a rebuild).
#
# Rebuild output goes back into figures/ and is NOT committed.  The leading
# slash matters: unanchored, "figures/" also matches docs/figures/.
/figures/
docs/figures/**/__pycache__/

# --- gen13 / gen14 separation artefacts -------------------------------------
# Same rule as the gen7-gen11 run artefacts above: fitted blobs and per-arm
# prediction dumps regenerate from the committed code, and the manifests and
# metrics CSVs that the reports cite are committed, so every quoted number stays
# checkable without them.
#
# Fitted model blobs (102 MB for gen13, over GitHub's per-file limit; both are
# version-fragile sklearn pickles).  Rebuild:
#   .venv/Scripts/python.exe gen13_separation/scripts/g13_predict.py fit
#   .venv/Scripts/python.exe gen14_direction/scripts/g14_predict.py fit
gen13_separation/models/*.joblib
gen14_direction/models/*.joblib

# Per-arm out-of-fold prediction dumps (296 files, 134 MB) and the few-shot pair
# tables (105 MB).  Rebuilt by scripts/g13_run_ladder.py and g13_fewshot_stage2.py.
gen13_separation/predictions/**/*.parquet
gen13_separation/metrics/**/fewshot_stage2_pairs.parquet

# Disk caches of the frozen bench (10 MB each, rebuilt in ~5 s by
# gen14.dirbench.load / the verify_direction runner).
gen14_direction/cache/
gen13_separation/analysis/stage3/verify_direction/bench_cache.pkl

# gen15: derived scoring tables, disk caches and agent scratch. Every one of these is rebuilt by
# the scripts in gen15_curve/scripts/ from the frozen gen13 cohort; the boards and contrast CSVs
# that back the report are checked in, the per-unit intermediates behind them are not.
gen15_curve/cache/
gen15_curve/models/*.joblib
gen15_curve/results/*.parquet
gen15_curve/exp/**/*.pkl
gen15_curve/exp/embed/*_fp.parquet
gen15_curve/exp/embed/ligand_embeddings.parquet
gen15_curve/exp/**/per_extractant_*.csv
gen15_curve/exp/kernel/results/ad_cells.csv
gen15_curve/exp/kernel/results/publeak_cells.csv
# gen15 agent arms: run logs and per-pair/per-extractant long tables. A 60 MB permutation log and
# ~25 MB of long-format intermediates are rebuilt by the scripts beside them; the summary CSVs the
# report quotes are checked in.
gen15_curve/exp/**/*_log.txt
gen15_curve/exp/**/*_long.csv
gen15_curve/exp/**/perext_*.csv
gen15_curve/exp/**/per_extractant_*.csv
gen15_curve/exp/**/s2s3_per_extractant_*.csv
gen15_curve/exp/decision/tables/*.parquet
gen15_curve/exp/**/*.csv.gz

# Cached intermediate, 12 MB; digest in gen16_anchor/PAIRS_BP_PKL.md
gen16_anchor/pairs_BP.pkl
