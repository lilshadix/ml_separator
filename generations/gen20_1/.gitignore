# gen20.1: per-row prediction and result tables are regenerated by the sealed scripts (digests in the manifests)
predictions/**/*.parquet
results/**/*.parquet
smoke*/
# in-flight unit files (fitting.write_unit writes <name>.tmp, then os.replace) and the per-design writer lock
predictions/**/*.tmp
predictions/**/.lock
# S5 staging directories (label-derived target statistics; kept only after a STOP or an error, for diagnosis)
.g201_describe_*/
# bytecode (gen201/bootstrap.py sets sys.dont_write_bytecode; this is a second guard)
__pycache__/
*.pyc
